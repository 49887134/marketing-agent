# Copy to backend/.env; real credentials are supplied privately. Never put them in VITE_*.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
# Independent OpenAI-compatible services; base URLs must include their API prefix, e.g. /v1.
EMBEDDING_BASE_URL=https://qianfan.baidubce.com/v2
EMBEDDING_API_KEY=
EMBEDDING_MODEL=embedding-v1
EMBEDDING_DIMENSIONS=384
# false: validate returned dimensions only; true: also send dimensions in embedding requests.
EMBEDDING_SEND_DIMENSIONS=false
CHAT_BASE_URL=https://qianfan.baidubce.com/v2
CHAT_API_KEY=
CHAT_MODEL=ernie-4.5-turbo-20260402
MODEL_TIMEOUT_SECONDS=35
RAG_MIN_SIMILARITY=0.35
# Optional for verify-full: DATABASE_SSLROOTCERT=C:/path/to/supabase-ca.crt
